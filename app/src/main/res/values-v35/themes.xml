<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 : désactive le mode bord à bord forcé, pour que la fenêtre
         se redimensionne normalement au-dessus du clavier (indispensable pour la page web X). -->
    <style name="Theme.Arc" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
